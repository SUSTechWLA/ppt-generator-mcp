{
  "name": "ppt-generator-mcp",
  "version": "1.0.0",
  "description": "MCP server for fixed-page HTML decks, template knowledge, rendering, and quality assurance.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "ppt-generator",
    "template",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsdom": "^29.1.1",
    "openai": "^6.49.0",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
