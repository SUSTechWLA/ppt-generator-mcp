# Optional OpenAI-compatible text model. Omit all three to use deterministic planning
# for plan_deck, or pass an Agent-authored plannedSpec to the lower-level slide tools.
PPT_LLM_BASE_URL=
PPT_LLM_API_KEY=
PPT_LLM_MODEL=

# Optional image API. Omit all fields when an Agent supplies externalAssets.
PPT_IMAGE_BASE_URL=
PPT_IMAGE_API_KEY=
PPT_IMAGE_MODEL=
PPT_IMAGE_ALLOWED_HOSTS=

# Optional multimodal reviewer. Chromium hard gates and deterministic scoring remain active without it.
PPT_REVIEW_BASE_URL=
PPT_REVIEW_API_KEY=
PPT_REVIEW_MODEL=

PPT_OUTPUT_ROOT=./output/runs
PPT_MAX_CONCURRENCY=2
PPT_REQUEST_TIMEOUT_MS=60000
PPT_MAX_INPUT_CHARS=120000
PPT_MAX_IMAGE_BYTES=12582912
