{
  "name": "ppt-generator-mcp",
  "version": "1.0.0",
  "description": "MCP Server that transforms HTML templates into deliverable pages (PPT/bid/report) via LLM orchestration.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "demo": "npx tsx tests/demo.ts",
    "test:templates": "npx tsx tests/test-all-templates.ts",
    "demo:source": "node --import tsx scripts/generate-personnel-deliverable.ts",
    "generate:personnel": "node --import tsx scripts/generate-personnel-deliverable.ts",
    "test": "npm run test:unit && npm run test:contract && npm run test:render && npm run test:e2e && npm run test:templates",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:render": "node --import tsx --test tests/render/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ppt-generator",
    "template",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsdom": "^29.1.1",
    "openai": "^6.49.0",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
